.empty {
  text-align: center;
  margin-top: 240rpx;
}
.empty-emoji { font-size: 120rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 40rpx; font-weight: 700; color: var(--choco); }
.empty-desc  { color: var(--muted); margin: 16rpx 0 48rpx; padding: 0 48rpx; }

.list { display: flex; flex-direction: column; gap: 20rpx; }

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 20rpx;
}

.item-emoji {
  font-size: 56rpx;
  flex-shrink: 0;
}

.item-main { flex: 1; }

.item-nick {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.item-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.dot { margin: 0 8rpx; }

.item-actions {
  padding: 12rpx 16rpx;
  font-size: 36rpx;
  opacity: 0.6;
}

button.btn {
  padding: 22rpx 64rpx;
  line-height: 1.2;
  border-radius: 999rpx;
}
button.btn::after { border: none; }
