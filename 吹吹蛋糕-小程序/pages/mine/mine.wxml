<view class="container">
  <view wx:if="{{cakes.length === 0}}" class="empty">
    <view class="empty-emoji">🎂</view>
    <view class="empty-title">还没有做过蛋糕</view>
    <view class="empty-desc">为朋友做一个，送一份跨越距离的生日惊喜吧。</view>
    <button class="btn" bindtap="goCreate">做一个蛋糕</button>
  </view>

  <view wx:else class="list">
    <view
      wx:for="{{cakes}}"
      wx:key="id"
      class="item card"
      bindtap="openCake"
      data-id="{{item.id}}"
    >
      <view class="item-emoji">{{item.emoji}}</view>
      <view class="item-main">
        <view class="item-nick">给 {{item.receiverNick}}</view>
        <view class="item-meta">
          <text>{{item.dateText}}</text>
          <text class="dot">·</text>
          <text>打开 {{item.openCount}} 次</text>
          <text wx:if="{{item.blowCount > 0}}" class="dot">·</text>
          <text wx:if="{{item.blowCount > 0}}">🎉 已吹灭</text>
        </view>
      </view>
      <view class="item-actions" catchtap="deleteCake" data-id="{{item.id}}">🗑️</view>
    </view>
  </view>
</view>
