.create {
  padding-bottom: 200rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-label {
  font-size: 28rpx;
  color: var(--choco);
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 蛋糕样式 */
.style-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 8rpx 32rpx;
}

.style-row {
  display: inline-flex;
  gap: 20rpx;
}

.style-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: #fff;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(62, 39, 35, 0.06);
  border: 4rpx solid transparent;
  transition: all 160ms ease;
}

.style-item.selected {
  border-color: var(--primary);
  transform: translateY(-4rpx);
}

.style-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.style-name {
  font-size: 22rpx;
  color: var(--choco);
  margin-top: 12rpx;
}

/* 蜡烛数量 */
.candle-input {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 12rpx;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--cream);
  color: var(--choco);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn:active {
  transform: scale(0.92);
}

.stepper-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  min-width: 96rpx;
  text-align: center;
}

.candle-colors {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  transition: all 150ms ease;
}

.color-dot.selected {
  transform: scale(1.15);
  box-shadow: 0 0 0 4rpx var(--primary);
}

/* 祝福表单 */
.form-row {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.form-input {
  font-size: 30rpx;
  height: 64rpx;
  color: var(--ink);
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.6;
}

.char-count {
  text-align: right;
  margin-top: 8rpx;
}

/* 语音 */
.voice-recorder {
  margin-top: 8rpx;
}

.voice-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--cream);
  color: var(--choco);
  font-size: 30rpx;
  transition: all 150ms ease;
}

.voice-btn.recording {
  background: var(--primary);
  color: #fff;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.7; }
}

.voice-icon {
  font-size: 36rpx;
}

.voice-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--cream);
  border-radius: 16rpx;
}

.voice-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--choco);
}

.voice-controls {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--choco);
}

.mini-btn.danger { color: var(--primary); }

/* 预览 */
.preview-box {
  padding: 48rpx 32rpx 64rpx;
  border-radius: 24rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.preview-nick {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--choco);
  margin-bottom: 24rpx;
}

.preview-cake {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.preview-flames {
  display: flex;
  gap: 8rpx;
  margin-bottom: -4rpx;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 360rpx;
}

.preview-candle {
  width: 12rpx;
  height: 48rpx;
  border-radius: 2rpx;
  position: relative;
}

.preview-flame {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 26rpx;
  background: radial-gradient(ellipse at center bottom, #FFD166 0%, #FF7A3A 60%, transparent 75%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  animation: flicker 0.6s ease-in-out infinite alternate;
}

@keyframes flicker {
  0%   { transform: translateX(-50%) scale(1)   translateY(0); opacity: 0.95; }
  100% { transform: translateX(-50%) scale(1.1) translateY(-2rpx); opacity: 1; }
}

.preview-top {
  width: 340rpx;
  height: 40rpx;
  border-radius: 20rpx 20rpx 4rpx 4rpx;
}

.preview-cream {
  width: 360rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-top: -6rpx;
  position: relative;
  z-index: 1;
}

.preview-base {
  width: 400rpx;
  height: 120rpx;
  border-radius: 8rpx 8rpx 16rpx 16rpx;
  margin-top: -4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-decor {
  color: #fff;
  font-size: 36rpx;
  letter-spacing: 8rpx;
}

.preview-age {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--choco);
  font-weight: 600;
}

/* CTA */
.cta-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255, 246, 242, 0.95);
  backdrop-filter: blur(10rpx);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(62, 39, 35, 0.06);
}

.cta-bar .btn {
  width: 100%;
  padding: 28rpx 0;
  font-size: 32rpx;
}

button.btn {
  padding: 28rpx 0;
  line-height: 1.2;
  border-radius: 999rpx;
}
button.btn::after { border: none; }
